# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGO_URI_TEST=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>_test

# JWT — استخدم قيم عشوائية قوية في الإنتاج (minimum 32 chars)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — حدد origins المسموحة (مفصولة بفواصل)
CORS_ORIGIN=http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
MAX_FILES=10

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@store.com

# Cache TTL (seconds)
CACHE_TTL_PRODUCTS=300
CACHE_TTL_CATEGORIES=600
CACHE_TTL_SETTINGS=3600

# Shipping
DEFAULT_SHIPPING_COST=25
FREE_SHIPPING_THRESHOLD=500

# Tax
DEFAULT_TAX_RATE=15

# SLA (hours)
SLA_FIRST_RESPONSE_HOURS=4
SLA_RESOLUTION_HOURS=24

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log
